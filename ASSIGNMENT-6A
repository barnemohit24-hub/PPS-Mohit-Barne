#include <stdio.h>
int fact_rec(int num);
int main(){

int num;
int result;
printf("Enter the number: ");
scanf("%d", &num);

if (num < 0 || num > 12){
printf("Enter a number between 0 and 12.\n");
return 1;
}

 result = fact_rec(num);
printf("Result = %d\n", result);

return 0;
}

int fact_rec(int num)
{
if (num == 0 || num == 1)
{
return 1;
}
else
{
return num * fact_rec(num - 1);
}
}
